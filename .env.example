NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/homi?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Set REDIS_URL OR the separate REDIS_* fields below.
# Use rediss:// for a provider requiring TLS.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USER=
REDIS_PASSWORD=

# Port 587: SMTP_SECURE=false (STARTTLS required).
# Port 465: SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
EMAIL_SENDER=your-email@example.com

# Configure later when implementing Google and the admin seed CLI.
GOOGLE_CLIENT_ID=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
